# OpenAI
OPENAI_API_KEY=replace_with_openai_api_key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Pinecone (use the index host shown in the Pinecone console)
PINECONE_API_KEY=replace_with_pinecone_api_key
PINECONE_INDEX_HOST=https://replace-with-index-host.svc.example.pinecone.io
PINECONE_NAMESPACE=support-kb
PINECONE_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.72

# Approval policy
APPROVAL_TTL_HOURS=24
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Local append-only audit sink
AUDIT_SINK_URL=http://127.0.0.1:8787
AUDIT_SINK_TOKEN=replace-with-a-random-token-at-least-32-characters
AUDIT_SINK_HOST=127.0.0.1
AUDIT_SINK_PORT=8787
AUDIT_LOG_PATH=./data/audit.ndjson

# Slack review channel
SLACK_SUPPORT_ESCALATION_CHANNEL=#support-review

# HubSpot ticket tracking
HUBSPOT_PRIVATE_ACCESS_TOKEN=replace_with_hubspot_private_app_token
HUBSPOT_SUPPORT_OWNER_ID=12345678
HUBSPOT_PIPELINE=0
HUBSPOT_NEW_STAGE=1
