# ==========================================
# 031-GDPR-Compliance-Auditor Configuration
# ==========================================

# --- Alerting ---
# ایمیلی که هشدارهای بحرانی GDPR به آن ارسال می‌شود
CRITICAL_ALERT_EMAIL=security-team@yourcompany.com

# --- OpenAI (برای تحلیل هوشمند) ---
# کلید API اوپن‌ای‌آی (اگر از Credential خود n8n استفاده می‌کنید، این خط نیاز نیست)
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Database (PostgreSQL) ---
# تنظیمات دیتابیس برای ذخیره نتایج حسابرسی
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gdpr_compliance_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password

# --- Email (SMTP) ---
# تنظیمات سرور ایمیل برای ارسال هشدارها
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# --- Web Scraping (Optional Proxy) ---
# اگر سایت‌ها IP شما را بلاک کردند، از پراکسی استفاده کنید
PROXY_ENABLED=false
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASSWORD=