            "Compliance Score": "={{ $json.compliance_score }}",
            "Critical": "={{ $json.violationCounts.critical }}",
            "High": "={{ $json.violationCounts.high }}",
            "Medium": "={{ $json.violationCounts.medium }}",
            "Low": "={{ $json.violationCounts.low }}",
            "Status": "={{ $json.hasCritical ? 'CRITICAL' : 'NEEDS REVIEW' }}"
          }
        },
        "options": {}
      },
      "id": "d0e1f2a3-b4c5-6789-defa-890123456789",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [2000, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_GS_ID",
          "name": "Google Sheets OAuth2"
        }
      }
    }
