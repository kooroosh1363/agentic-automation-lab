        "tableId": "tenants",
        "columns": "tenant_id,company_name,industry,admin_email,admin_name,plan_type,employee_count,created_at,status",
        "values": "={{ $json.tenantId }},{{ $json.companyName }},{{ $json.industry }},{{ $json.adminEmail }},{{ $json.adminName }},{{ $json.planType }},{{ $json.employeeCount }},{{ $json.createdAt }},onboarding_started"
