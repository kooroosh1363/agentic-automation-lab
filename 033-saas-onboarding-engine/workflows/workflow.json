    {
      "parameters": {
        "jsCode": "// Parse incoming webhook data\nconst body = $input.first().json.body || $input.first().json;\n\nconst companyName = body.company_name || body.companyName;\nconst industry = body.industry || 'General';\nconst adminEmail = body.admin_email || body.adminEmail;\nconst adminName = body.admin_name || body.adminName;\nconst planType = body.plan_type || body.plan || 'Pro';\nconst employeeCount = parseInt(body.employee_count || body.employeeCount || '10');\n\n// Generate a unique tenant ID\nconst tenantId = companyName.toLowerCase().replace(/\\s+/g, '-') + '-' + Date.now().toString().slice(-4);\n\nreturn [{\n  json: {\n    tenantId,\n    companyName,\n    industry,\n    adminEmail,\n    adminName,\n    planType,\n    employeeCount,\n    createdAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Parse & Prepare Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
