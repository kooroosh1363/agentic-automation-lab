{
  "name": "34-AI-Content-Repurposing-Engine",
  "nodes": [
    {
      "parameters": {
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id={{ $env.YOUTUBE_CHANNEL_ID }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "RSS Feed Trigger",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract video ID and prepare for transcription\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const videoUrl = item.json.link || item.json.url;\n  const videoId = videoUrl.match(/(?:v=|\\/)([0-9A-Za-z_-]{11})/)?.[1];\n  const title = item.json.title;\n  const publishedAt = item.json.isoDate || item.json.pubDate;\n  \n  if (videoId) {\n    results.push({\n      json: {\n        videoId,\n        title,\n        publishedAt,\n        videoUrl,\n        thumbnailUrl: `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Extract Video Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://www.googleapis.com/youtube/v3/captions?videoId={{ $json.videoId }}&part=snippet",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.YOUTUBE_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
      "name": "Fetch Video Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4",
          "mode": "list",
          "cachedResultName": "GPT-4"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a Content Repurposing Expert. Analyze the video transcript and create 5 different content formats optimized for each platform. Return JSON with: twitter_post (280 chars max), linkedin_post (professional tone), instagram_caption (with hashtags), newsletter_snippet (engaging summary), blog_article (800 words, SEO optimized), and image_prompt (for DALL-E thumbnail generation)."
            },
            {
              "role": "user",
              "content": "=Video Title: {{ $('Extract Video Info').item.json.title }}\nPublished At: {{ $('Extract Video Info').item.json.publishedAt }}\n\nTranscript:\n{{ $json.items[0].snippet.text || 'Transcript not available' }}\n\nCreate 5 platform-optimized content pieces and an image generation prompt."
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 3000,
          "responseFormat": "json_object"
        }
      },
      "id": "d4e5f6a7-b8c9-0123-defa-234567890123",
      "name": "AI Generate Multi-Platform Content",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.7,
      "position": [900, 300],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_OPENAI_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "dall-e-3",
          "mode": "list",
          "cachedResultName": "DALL-E 3"
        },
        "prompt": "=Generate a professional, eye-catching thumbnail image for a YouTube video. Style: Modern, clean, high contrast. Content: {{ JSON.parse($('AI Generate Multi-Platform Content').item.json.message.content).image_prompt }}",
