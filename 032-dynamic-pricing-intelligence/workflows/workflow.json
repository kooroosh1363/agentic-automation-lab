      "id": "d4e5f6a7-b8c9-0123-defa-234567890123",
      "name": "Fetch Competitor 3 Price",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 600]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate competitor prices and calculate statistics\nconst products = [];\n\n// Process each competitor response\nfor (const item of $input.all()) {\n  const data = item.json;\n  products.push({\n    competitor: item.node.name.replace('Fetch ', '').replace(' Price', ''),\n    price: parseFloat(data.price),\n    currency: data.currency || 'USD',\n    inStock: data.inStock !== false,\n    lastUpdated: data.lastUpdated || new Date().toISOString()\n  });\n}\n\n// Calculate statistics\nconst prices = products.map(p => p.price).filter(p => !isNaN(p));\nconst avgPrice = prices.reduce((a, b) => a + b, 0) / prices.length;\nconst minPrice = Math.min(...prices);\nconst maxPrice = Math.max(...prices);\nconst medianPrice = prices.sort((a, b) => a - b)[Math.floor(prices.length / 2)];\n\n// Calculate standard deviation\nconst variance = prices.reduce((sum, p) => sum + Math.pow(p - avgPrice, 2), 0) / prices.length;\nconst stdDev = Math.sqrt(variance);\n\n// Get current product info (from trigger or previous node)\nconst productId = $('Schedule Trigger').item.json.productId || 'PROD-001';\nconst currentPrice = $('Schedule Trigger').item.json.currentPrice || 99.99;\nconst stockLevel = $('Schedule Trigger').item.json.stockLevel || 100;\nconst targetMargin = $('Schedule Trigger').item.json.targetMargin || 0.25;\n\nreturn [{\n  json: {\n    productId,\n    currentPrice,\n    stockLevel,\n    targetMargin,\n    competitorAnalysis: {\n      prices,\n      average: avgPrice,\n      minimum: minPrice,\n      maximum: maxPrice,\n      median: medianPrice,\n      stdDeviation: stdDev,\n      competitorCount: products.length,\n      competitorsInStock: products.filter(p => p.inStock).length\n    },\n    marketPosition: currentPrice < avgPrice ? 'below_market' : currentPrice > avgPrice ? 'above_market' : 'at_market',\n    priceGap: ((currentPrice - avgPrice) / avgPrice * 100).toFixed(2),\n    analyzedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "e5f6a7b8-c9d0-1234-efab-345678901234",
      "name": "Calculate Price Statistics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 400]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4",
          "mode": "list",
          "cachedResultName": "GPT-4"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a Dynamic Pricing Strategist AI. Analyze competitor pricing data and recommend optimal pricing strategy. Consider: market position, stock levels, profit margins, competitor availability, and price volatility. Return JSON with: recommended_price, strategy (aggressive/conservative/neutral), confidence_score (0-100), reasoning, risk_factors (array), and action (increase/decrease/maintain)."
            },
            {
              "role": "user",
              "content": "=Product ID: {{ $json.productId }}\nCurrent Price: ${{ $json.currentPrice }}\nStock Level: {{ $json.stockLevel }} units\nTarget Margin: {{ $json.targetMargin * 100 }}%\n\nCompetitor Analysis:\n- Average Price: ${{ $json.competitorAnalysis.average.toFixed(2) }}\n- Minimum Price: ${{ $json.competitorAnalysis.minimum.toFixed(2) }}\n- Maximum Price: ${{ $json.competitorAnalysis.maximum.toFixed(2) }}\n- Median Price: ${{ $json.competitorAnalysis.median.toFixed(2) }}\n- Price Std Deviation: ${{ $json.competitorAnalysis.stdDeviation.toFixed(2) }}\n- Competitors In Stock: {{ $json.competitorAnalysis.competitorsInStock }}/{{ $json.competitorAnalysis.competitorCount }}\n\nMarket Position: {{ $json.marketPosition }}\nPrice Gap from Average: {{ $json.priceGap }}%\n\nRecommend optimal pricing strategy."
            }
          ]
        },
        "options": {
          "temperature": 0.4,
          "maxTokens": 1500,
          "responseFormat": "json_object"
        }
      },
      "id": "f6a7b8c9-d0e1-2345-fabc-456789012345",
      "name": "AI Pricing Strategy",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.7,
      "position": [900, 400],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_OPENAI_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse AI response and prepare decision data\nconst aiResponse = JSON.parse($input.first().json.message.content);\nconst inputData = $('Calculate Price Statistics').item.json;\n\nconst recommendedPrice = parseFloat(aiResponse.recommended_price);\nconst currentPrice = inputData.currentPrice;\nconst priceChange = recommendedPrice - currentPrice;\nconst priceChangePercent = ((priceChange / currentPrice) * 100).toFixed(2);\n\n// Determine action urgency\nlet urgency = 'low';\nif (Math.abs(priceChangePercent) > 10) urgency = 'high';\nelse if (Math.abs(priceChangePercent) > 5) urgency = 'medium';\n\nreturn [{\n  json: {\n    productId: inputData.productId,\n    currentPrice,\n    recommendedPrice,\n    priceChange,\n    priceChangePercent: parseFloat(priceChangePercent),\n    strategy: aiResponse.strategy,\n    confidence: aiResponse.confidence_score,\n    reasoning: aiResponse.reasoning,\n    riskFactors: aiResponse.risk_factors || [],\n    action: aiResponse.action,\n    urgency,\n    needsAction: Math.abs(priceChangePercent) > 2, // Only act if change > 2%\n    marketData: inputData.competitorAnalysis,\n    analyzedAt: inputData.analyzedAt,\n    decisionMadeAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "a7b8c9d0-e1f2-3456-abcd-567890123456",
      "name": "Process AI Recommendation",
