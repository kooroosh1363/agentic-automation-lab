    {
      "parameters": {
        "jsCode": "// Convert Markdown report to basic HTML for PDF generation\nconst markdown = $input.first().json.message.content;\nconst topic = $('Research Request Webhook').item.json.body.topic;\n\n// Simple Markdown to HTML conversion (headers, lists, paragraphs)\nlet html = markdown\n  .replace(/^### (.*$)/gim, '<h3>$1</h3>')\n  .replace(/^## (.*$)/gim, '<h2>$1</h2>')\n  .replace(/^# (.*$)/gim, '<h1>$1</h1>')\n  .replace(/\\*\\*(.*?)\\*\\*/gim, '<strong>$1</strong>')\n  .replace(/\\* (.*$)/gim, '<li>$1</li>')\n  .replace(/\\n\\n/gim, '<br><br>');\n\n// Wrap in a professional HTML template\nconst fullHtml = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 800px; margin: 0 auto; padding: 20px; }\n    h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 10px; }\n    h2 { color: #2980b9; margin-top: 30px; }\n    h3 { color: #16a085; }\n    li { margin-bottom: 5px; }\n    .header { text-align: center; margin-bottom: 40px; }\n    .footer { margin-top: 50px; text-align: center; font-size: 12px; color: #7f8c8d; }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>Market Research Report</h1>\n    <p><strong>Topic:</strong> ${topic}</p>\n    <p><strong>Date:</strong> ${new Date().toLocaleDateString()}</p>\n  </div>\n  ${html}\n  <div class=\"footer\">\n    <p>Generated automatically by AI Multi-Agent System | Confidential</p>\n  </div>\n</body>\n</html>`;\n\nreturn [{ json: { htmlContent: fullHtml, fileName: `Research_${topic.replace(/\\s+/g, '_')}.pdf` } }];"
      },
