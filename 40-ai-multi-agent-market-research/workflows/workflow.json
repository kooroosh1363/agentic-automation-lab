      "id": "d4e5f6a7-b8c9-0123-defa-234567890123",
      "name": "AI Writer Agent",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.7,
      "position": [900, 300],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_OPENAI_ID",
          "name": "OpenAI API"
        }
      }
