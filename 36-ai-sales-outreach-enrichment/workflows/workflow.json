    {
      "parameters": {
        "jsCode": "// Normalize incoming lead data\nconst body = $input.first().json.body || $input.first().json;\n\nreturn [{\n  json: {\n    leadId: body.lead_id || 'LEAD-' + Date.now(),\n    firstName: body.first_name || body.firstName,\n    lastName: body.last_name || body.lastName,\n    email: body.email,\n    company: body.company,\n    domain: body.domain || body.company.toLowerCase().replace(/\\s+/g, '') + '.com',\n    title: body.title || 'Decision Maker'\n  }\n}];"
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Parse Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.clearbit.com/v2/companies/find?domain={{ $json.domain }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.CLEARBIT_API_KEY }}"
            }
          ]
        },
        "options": {
          "allowUnauthorizedCerts": true,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
      "name": "Enrich Company Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4",
          "mode": "list",
          "cachedResultName": "GPT-4"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert B2B Sales Development Representative (SDR). Analyze the provided company data and extract a unique, recent 'hook' (e.g., recent funding, new product launch, leadership change, or notable growth) that can be used to personalize a cold email. Return ONLY a JSON object with: {\"hook\": \"string\", \"company_size\": \"number\", \"industry\": \"string\"}."
            },
            {
              "role": "user",
              "content": "=Company Name: {{ $('Parse Lead Data').item.json.company }}\nDomain: {{ $('Parse Lead Data').item.json.domain }}\nEnrichment Data: {{ JSON.stringify($json) }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 500,
          "responseFormat": "json_object"
        }
      },
      "id": "d4e5f6a7-b8c9-0123-defa-234567890123",
      "name": "AI Extract Personalization Hook",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.7,
      "position": [900, 300],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_OPENAI_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4",
          "mode": "list",
          "cachedResultName": "GPT-4"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a world-class copywriter for B2B SaaS. Write a hyper-personalized, concise cold email (under 150 words). Use the provided 'hook' naturally in the first sentence. Do not sound like a generic AI. Be conversational, respectful, and end with a low-friction call to action (e.g., 'Open to a brief chat next week?'). Return ONLY a JSON object with: {\"subject\": \"string\", \"body\": \"string\"}."
            },
            {
              "role": "user",
              "content": "=Prospect Name: {{ $('Parse Lead Data').item.json.firstName }}\nProspect Title: {{ $('Parse Lead Data').item.json.title }}\nCompany: {{ $('Parse Lead Data').item.json.company }}\nPersonalization Hook: {{ JSON.parse($('AI Extract Personalization Hook').item.json.message.content).hook }}\nIndustry: {{ JSON.parse($('AI Extract Personalization Hook').item.json.message.content).industry }}"
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 600,
          "responseFormat": "json_object"
        }
      },
      "id": "e5f6a7b8-c9d0-1234-efab-345678901234",
      "name": "AI Write Hyper-Personalized Email",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.7,
      "position": [1120, 300],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_OPENAI_ID",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Calculate Lead Score\nconst item = $input.first().json;\nconst aiData = JSON.parse($('AI Extract Personalization Hook').item.json.message.content);\n\nlet score = 50; // Base score\nif (aiData.company_size && aiData.company_size > 50) score += 20;\nif (item.title.toLowerCase().includes('founder') || item.title.toLowerCase().includes('ceo') || item.title.toLowerCase().includes('director')) score += 20;\nif (aiData.hook && aiData.hook.length > 10) score += 10;\n\nreturn [{\n  json: {\n    ...item,\n    aiData,\n    leadScore: Math.min(score, 100)\n  }\n}];"
      },
      "id": "f6a7b8c9-d0e1-2345-fabc-456789012345",
      "name": "Calculate Lead Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition1",
              "leftValue": "={{ $json.leadScore }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a7b8c9d0-e1f2-3456-abcd-567890123456",
      "name": "Check Lead Score",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Parse Lead Data').item.json.email }}",
        "subject": "={{ JSON.parse($('AI Write Hyper-Personalized Email').item.json.message.content).subject }}",
        "emailType": "html",
        "html": "=<div style='font-family: Arial, sans-serif; line-height: 1.6; color: #333;'>\n  <p>Hi {{ $('Parse Lead Data').item.json.firstName }},</p>\n  <p>{{ JSON.parse($('AI Write Hyper-Personalized Email').item.json.message.content).body }}</p>\n  <p>Best regards,<br><strong>[Your Name]</strong><br>[Your Title]</p>\n</div>",
        "options": {}
      },
      "id": "b8c9d0e1-f2a3-4567-bcde-678901234567",
      "name": "Send Personalized Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
