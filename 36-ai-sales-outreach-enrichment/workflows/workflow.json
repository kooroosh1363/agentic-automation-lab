        "jsonBody": "={\n  \"properties\": {\n    \"email\": \"={{ $('Parse Lead Data').item.json.email }}\",\n    \"firstname\": \"={{ $('Parse Lead Data').item.json.firstName }}\",\n    \"lastname\": \"={{ $('Parse Lead Data').item.json.lastName }}\",\n    \"company\": \"={{ $('Parse Lead Data').item.json.company }}\",\n    \"lead_score\": \"={{ $json.leadScore }}\",\n    \"personalization_hook\": \"={{ $json.aiData.hook }}\",\n    \"lifecyclestage\": \"lead\"\n  }\n}",
        "options": {}
      },
