    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst times = data.hourly.time;\nconst temperatures = data.hourly.temperature_2m;\n\n// تاریخ اولین رکورد (مثلاً 2026-07-08)\nconst targetDate = times[0].split(\"T\")[0];\n\nlet maxTemp = -Infinity;\nlet minTemp = Infinity;\nlet maxTime = \"\";\nlet minTime = \"\";\n\nfor (let i = 0; i < times.length; i++) {\n    if (!times[i].startsWith(targetDate)) {\n        break; // فقط روز اول بررسی شود\n    }\n\n    const temp = temperatures[i];\n\n    if (temp > maxTemp) {\n        maxTemp = temp;\n        maxTime = times[i];\n    }\n\n    if (temp < minTemp) {\n        minTemp = temp;\n        minTime = times[i];\n    }\n}\n\nreturn [\n    {\n        json: {\n            date: targetDate,\n            max_temperature: maxTemp,\n            max_temperature_time: maxTime,\n            min_temperature: minTemp,\n            min_temperature_time: minTime\n        }\n    }\n];"
      },
