# LLM provider (OpenAI Chat Completions-compatible API)
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-provider-api-key
OPENAI_MODEL=gpt-4o-mini

# Intake authentication and triage policy
TICKET_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters
TRIAGE_CONFIDENCE_THRESHOLD=0.70

# Signed, exact-draft approval
APPROVAL_SIGNING_SECRET=replace-with-a-different-random-secret-at-least-32-characters
APPROVAL_TTL_HOURS=4
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Restricted reviewer notification channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace-me

# Ticket system API (local reference adapter defaults)
TICKET_API_URL=http://127.0.0.1:8789/api
TICKET_API_TOKEN=replace-with-ticket-api-token
TICKET_API_HOST=127.0.0.1
TICKET_API_PORT=8789
TICKET_EVENT_LOG_PATH=./data/ticket-events.ndjson

# Local append-only audit sink
AUDIT_SINK_URL=http://127.0.0.1:8788
AUDIT_SINK_TOKEN=replace-with-a-random-token-at-least-32-characters
AUDIT_SINK_HOST=127.0.0.1
AUDIT_SINK_PORT=8788
AUDIT_LOG_PATH=./data/audit.ndjson
