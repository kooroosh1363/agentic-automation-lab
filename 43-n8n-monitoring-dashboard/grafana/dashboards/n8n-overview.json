{
  "title": "n8n Infrastructure Overview",
  "uid": "n8n-overview",
  "schemaVersion": 36,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Memory Usage (MB)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "process_resident_memory_bytes / 1024 / 1024", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Workflows",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "n8n_active_workflows", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queue Size",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "bull_queue_waiting", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory Over Time",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "process_resident_memory_bytes / 1024 / 1024", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue Size Over Time",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "bull_queue_waiting", "refId": "A" }
      ]
    }
  ],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s"
}